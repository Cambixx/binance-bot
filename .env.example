# Copia este archivo a .env y rellena tus valores. NUNCA comitees el .env real.
# El .env está en .gitignore. Restringe permisos: chmod 600 .env

# --- Binance ---
# Solo necesario si usas test_connection.js o, en el futuro, trading real.
# El bot en shadow mode NO necesita estas claves (usa datos públicos).
# Si las pones: crea una API key con SOLO lectura, SIN permiso de retiro, y con
# allow-list de IP. Si una clave se filtró alguna vez, ROTÍLALA en Binance.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
# Secret token del webhook (fix seguridad #15). Genera uno aleatorio y regístralo:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>&secret_token=<ESTE_VALOR>"
TELEGRAM_WEBHOOK_SECRET=

# --- Canales opcionales ---
# Canal long/short SMA150 (always-in): default ON. Ponlo a false para apagarlo.
LONGSHORT_ENABLED=true
# Activa el canal experimental de rotación cross-sectional + dual-momentum.
ROTATION_ENABLED=false
